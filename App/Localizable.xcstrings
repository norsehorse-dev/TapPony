    "\"Show from the reply\" must start with json: or header:." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aus der Antwort anzeigen“ muss mit json: oder header: beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mostrar de la respuesta” debe empezar por json: o header:."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Afficher depuis la réponse » doit commencer par json: ou header:."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mostrar da resposta” precisa começar com json: ou header:."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение «Показывать из ответа» должно начинаться с json: или header:."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“从响应中显示”必须以 json: 或 header: 开头。"
