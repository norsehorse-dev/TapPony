    "That host looks like a number written in an unusual form. Write IP addresses as four plain numbers, like 192.168.1.10." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Host sieht aus wie eine Zahl in ungewöhnlicher Schreibweise. Schreib IP-Adressen als vier einfache Zahlen, etwa 192.168.1.10."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese host parece un número escrito de forma inusual. Escribe las direcciones IP como cuatro números simples, por ejemplo 192.168.1.10."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet hôte ressemble à un nombre écrit sous une forme inhabituelle. Écrivez les adresses IP sous forme de quatre nombres simples, comme 192.168.1.10."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse host parece um número escrito de forma incomum. Escreva endereços IP como quatro números simples, como 192.168.1.10."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот хост похож на число, записанное в необычной форме. Записывайте IP-адреса как четыре обычных числа, например 192.168.1.10."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该主机看起来是以不常见形式书写的数字。请将 IP 地址写成四组普通数字，例如 192.168.1.10。"
          }
        }
      }
    },
