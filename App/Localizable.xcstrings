    "For your own server: a ten-line PHP script that appends each scan to a CSV file. The script is on tappony.app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für deinen eigenen Server: ein zehnzeiliges PHP-Skript, das jeden Scan an eine CSV-Datei anhängt. Das Skript findest du auf tappony.app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para tu propio servidor: un script PHP de diez líneas que añade cada escaneo a un archivo CSV. El script está en tappony.app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour votre propre serveur : un script PHP de dix lignes qui ajoute chaque scan à un fichier CSV. Le script est disponible sur tappony.app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para seu próprio servidor: um script PHP de dez linhas que adiciona cada leitura a um arquivo CSV. O script está em tappony.app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для собственного сервера: PHP-скрипт из десяти строк, который добавляет каждое сканирование в CSV-файл. Скрипт есть на tappony.app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于你自己的服务器：一个十行的 PHP 脚本，会将每次扫描追加到 CSV 文件中。脚本可在 tappony.app 上获取。"
          }
        }
      }
    },
