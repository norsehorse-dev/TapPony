    "After this write the tag can never be changed or erased. There is no undo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach diesem Schreibvorgang kann das Tag nie mehr geändert oder gelöscht werden. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de esta escritura, la etiqueta nunca podrá cambiarse ni borrarse. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après cette écriture, le tag ne pourra plus jamais être modifié ni effacé. Cette action est irréversible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois desta gravação, a tag nunca mais poderá ser alterada nem apagada. Não há como desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После этой записи метку больше никогда нельзя будет изменить или стереть. Отменить это невозможно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次写入之后，此标签将永远无法更改或擦除。此操作无法撤销。"
          }
        }
      }
    },
