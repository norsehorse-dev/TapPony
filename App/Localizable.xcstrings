    "The tag moved away before it was fully read. Hold it still and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tag wurde entfernt, bevor es vollständig gelesen war. Halte es ruhig und versuch es noch mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La etiqueta se alejó antes de leerse por completo. Mantenla quieta e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tag s’est éloigné avant la fin de la lecture. Maintenez-le immobile et réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
