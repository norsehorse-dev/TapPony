    "Allow plain HTTP on the local network" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unverschlüsseltes HTTP im lokalen Netzwerk erlauben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir HTTP sin cifrar en la red local"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser le HTTP non chiffré sur le réseau local"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir HTTP sem criptografia na rede local"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить обычный HTTP в локальной сети"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许在局域网中使用明文 HTTP"
          }
        }
      }
    },
    "Any phone that taps this tag opens the link." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Handy, das dieses Tag antippt, öffnet den Link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier teléfono que toque esta etiqueta abre el enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout téléphone approché de ce tag ouvre le lien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer celular que tocar nesta tag abre o link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой телефон, коснувшийся этой метки, откроет ссылку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何手机触碰此标签都会打开该链接。"
          }
        }
      }
    },
    "Anyone on the same Wi-Fi can read a plain HTTP request, including any secrets in it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder im selben WLAN kann eine unverschlüsselte HTTP-Anfrage mitlesen, einschließlich aller darin enthaltenen Secrets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier persona en la misma red Wi-Fi puede leer una solicitud HTTP sin cifrar, incluidos los secretos que contenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne sur le même Wi-Fi peut lire une requête HTTP non chiffrée, y compris les secrets qu’elle contient."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa na mesma rede Wi-Fi pode ler uma requisição HTTP sem criptografia, incluindo os segredos que ela contiver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой в той же сети Wi-Fi может прочитать обычный HTTP-запрос, включая все секреты в нём."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一 Wi-Fi 上的任何人都能读取明文 HTTP 请求，包括其中的任何机密。"
          }
        }
      }
    },
