    "Scans one NFC tag and returns its UID, chip, and NDEF content. Nothing is sent anywhere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannt ein NFC-Tag und gibt seine UID, den Chip und den NDEF-Inhalt zurück. Es wird nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
