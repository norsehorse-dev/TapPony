    "Pick at least one profile to send to." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mindestens ein Profil als Ziel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige al menos un perfil al que enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez au moins un profil de destination."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha pelo menos um perfil para onde enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите хотя бы один профиль для отправки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少选择一个要发送到的配置。"
          }
        }
      }
    },
    "Pick the profile by the tag itself, so the garage sticker and the office badge can go to different places without switching." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Profil anhand des Tags selbst, damit der Aufkleber in der Garage und der Ausweis im Büro ohne Umschalten an verschiedene Ziele gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el perfil según la propia etiqueta, para que la pegatina del garaje y la credencial de la oficina vayan a sitios distintos sin tener que cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tag lui-même choisit le profil : l’autocollant du garage et le badge du bureau peuvent ainsi aller à des endroits différents sans changer de profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o perfil pela própria tag, assim o adesivo da garagem e o crachá do escritório podem ir para lugares diferentes sem você precisar trocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль выбирается по самой метке, так что наклейка в гараже и пропуск в офисе могут отправлять данные в разные места без переключения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据标签本身选择配置，这样车库的贴纸和办公室的工牌无需切换就能发送到不同的地方。"
          }
        }
      }
    },
    "Plain HTTP only goes to local network addresses. Use https:// for anything on the internet." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unverschlüsseltes HTTP geht nur an Adressen im lokalen Netzwerk. Nutze https:// für alles im Internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El HTTP sin cifrar solo se envía a direcciones de la red local. Usa https:// para cualquier destino en internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le HTTP non chiffré n’est envoyé qu’aux adresses du réseau local. Utilisez https:// pour tout ce qui est sur Internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP sem criptografia só pode ir para endereços da rede local. Use https:// para qualquer coisa na internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный HTTP отправляется только на адреса в локальной сети. Для всего, что находится в интернете, используйте https://."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明文 HTTP 只能发往局域网地址。发往互联网的请求请使用 https://。"
          }
        }
      }
    },
    "Plain text, readable by any NFC app and by {ndef_text} in TapPony." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
