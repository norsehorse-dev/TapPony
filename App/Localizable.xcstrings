    "This tag shows a random ID each time, so its UID can't identify it. Use NDEF content or a TapPony launch link instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Tag zeigt jedes Mal eine zufällige ID, daher lässt es sich nicht über seine UID erkennen. Nutze stattdessen NDEF-Inhalt oder einen TapPony-Startlink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta etiqueta muestra un ID aleatorio cada vez, así que su UID no sirve para identificarla. Usa contenido NDEF o un enlace de inicio de TapPony."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce tag présente un identifiant aléatoire à chaque fois, son UID ne permet donc pas de l’identifier. Utilisez plutôt du contenu NDEF ou un lien de lancement TapPony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tag mostra um ID aleatório a cada vez, então o UID dela não serve para identificá-la. Use conteúdo NDEF ou um link de abertura do TapPony."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта метка каждый раз показывает случайный идентификатор, поэтому по её UID её нельзя опознать. Используйте NDEF-содержимое или ссылку запуска TapPony."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此标签每次显示的都是随机 ID，因此无法用其 UID 识别它。请改用 NDEF 内容或 TapPony 启动链接。"
          }
        }
      }
    },
