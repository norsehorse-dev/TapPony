          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê uma tag NFC e retorna o UID, o chip e o conteúdo NDEF dela. Nada é enviado para lugar nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирует одну NFC-метку и возвращает её UID, чип и NDEF-содержимое. Ничего никуда не отправляется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
