    "Add an http in node (POST) and put its path in the URL." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen „http in“-Node (POST) hinzu und trag seinen Pfad in die URL ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un nodo “http in” (POST) y pon su ruta en la URL."
