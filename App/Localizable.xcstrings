    "Checked from the top. The first match decides, and every profile it lists gets the scan." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird von oben nach unten geprüft. Der erste Treffer entscheidet, und jedes darin aufgeführte Profil bekommt den Scan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comprueban de arriba abajo. La primera coincidencia decide, y todos los perfiles que incluye reciben el escaneo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiées de haut en bas. La première qui correspond l’emporte, et chaque profil qu’elle indique reçoit le scan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificadas de cima para baixo. A primeira correspondência decide, e todos os perfis listados nela recebem a leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяются сверху вниз. Решает первое совпадение, и сканирование получает каждый указанный в нём профиль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从上往下检查。以第一条匹配的规则为准，该规则列出的每个配置都会收到这次扫描。"
          }
        }
      }
    },
