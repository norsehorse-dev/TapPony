    "NFCReaderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony reads the tags you scan and sends their details to the server you set up."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony liest die Tags, die du scannst, und sendet ihre Details an den Server, den du eingerichtet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony lee las etiquetas que escaneas y envía sus detalles al servidor que configuraste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony lit les tags que vous scannez et envoie leurs détails au serveur que vous avez configuré."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O TapPony lê as tags que você escaneia e envia os detalhes delas para o servidor que você configurou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony считывает метки, которые вы сканируете, и отправляет их данные на настроенный вами сервер."
          }
