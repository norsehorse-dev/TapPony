        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony 会读取你扫描的标签，并将标签详情发送到你设置的服务器。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony sends scans to servers on your local network, such as Home Assistant, when a profile points there."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony sendet Scans an Server in deinem lokalen Netzwerk, etwa Home Assistant, wenn ein Profil dorthin zeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony envía los escaneos a servidores de tu red local, como Home Assistant, cuando un perfil apunta allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony envoie les scans aux serveurs de votre réseau local, comme Home Assistant, lorsqu’un profil pointe vers eux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O TapPony envia leituras para servidores na sua rede local, como o Home Assistant, quando um perfil aponta para eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapPony отправляет сканирования на серверы в вашей локальной сети, например Home Assistant, если профиль указывает туда."
          }
